# Repository publik hanya berisi paket extension dan dokumentasi.
/*
!/.gitignore
!/README.md
!/PRIVACY.md
!/manifest.json
!/package.json
!/src/
!/assets/
!/tests/
/tests/*
!/tests/brand-guard-calibration.mjs
!/tests/brand-identity.mjs
/history-extract/

# Jangan commit data pengujian, file hasil pencatatan, secret, atau cache.
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/*.log
**/HeuriShield_Dataset*.json
**/evaluationDataset*.json
**/.DS_Store
**/Thumbs.db
